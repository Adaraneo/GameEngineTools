<Window x:Class="TerrainEditor.TileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dlaždice" Height="560" Width="920"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                    Text="Skládaná mapa ze skutečně uložených dlaždic (poloha podle jejich OriginX/OriginY) — klikni na mapu nebo do seznamu a načti." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="LoadButton" Content="Načíst" IsEnabled="False" Padding="10,3" Click="LoadButton_Click" />
            <TextBlock x:Name="SelectionLabel" Text="Nic nevybráno" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FF444444" BorderThickness="1" Background="#FF151515">
                <Grid>
                    <Image x:Name="MapImage" Stretch="Uniform" SnapsToDevicePixels="True" Cursor="Cross"
                           MouseLeftButtonDown="MapImage_MouseLeftButtonDown" />
                    <TextBlock x:Name="MapEmptyLabel" Text="Zatím žádné dlaždice v této terrain.db."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#FF333333" />

            <ListView x:Name="TileListView" Grid.Column="2" MouseDoubleClick="TileListView_MouseDoubleClick"
                      SelectionChanged="TileListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" Width="150" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="OriginX (m)" Width="80" DisplayMemberBinding="{Binding OriginX, StringFormat={}{0:0.0}}" />
                        <GridViewColumn Header="OriginY (m)" Width="80" DisplayMemberBinding="{Binding OriginY, StringFormat={}{0:0.0}}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
