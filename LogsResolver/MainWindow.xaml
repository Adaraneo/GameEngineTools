<Window x:Class="LogsResolver.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Logs Resolver"
        Height="900"
        Width="1500"
        MinHeight="700"
        MinWidth="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <ToolBar DockPanel.Dock="Top" IsEnabled="{Binding IsInterfaceEnabled}" UseLayoutRounding="False">
            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
            <Button Content="Open NPC JSON" Command="{Binding OpenNpcFolderCommand}" />
            <Button Content="Reload" Command="{Binding ReloadSessionCommand}" />
            <Separator />
            <TextBlock Text="Root:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary.RootPath}" VerticalAlignment="Center" />
            <Separator />
            <TextBlock Text="NPC:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentNpcFolder}" VerticalAlignment="Center" />
        </ToolBar>

        <Grid DockPanel.Dock="Top" Margin="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="14"
                         IsIndeterminate="{Binding IsLoading}"
                         Minimum="0"
                         Maximum="100" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LoadingProgressText}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <Grid Margin="8" IsEnabled="{Binding IsInterfaceEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Events:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Summary.EventCount}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="JSONL:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.JsonFileCount}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Text:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.TextFileCount}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Diagnostics:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.DiagnosticCount}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Quick Filters">
                        <StackPanel>
                            <TextBlock Text="Person" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Summary.Persons}"
                                      SelectedItem="{Binding Summary.SelectedPerson, Mode=TwoWay}"
                                      IsEditable="True"
                                      Margin="0,2,0,6" />
                            <TextBlock Text="Subsystem" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Summary.Subsystems}"
                                      SelectedItem="{Binding Summary.SelectedSubsystem, Mode=TwoWay}"
                                      IsEditable="True"
                                      Margin="0,2,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply" Command="{Binding ApplyQuickFiltersCommand}" />
                                <Button Content="Clear" Command="{Binding EventsExplorer.ClearFiltersCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    
                    <GroupBox Header="NPC Timeline">
                        <StackPanel>
                            <TextBlock Text="NPC JSON files:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CharacterTimeline.CharacterCount}" />
                            <TextBlock Text="Selected PersonId" FontWeight="SemiBold" />
                            <TextBox Text="{Binding CharacterTimeline.SelectedPersonIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Loaded NPCs" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding CharacterTimeline.Characters}"
                                     SelectedItem="{Binding CharacterTimeline.SelectedCharacter, Mode=TwoWay}"
                                     DisplayMemberPath="Label"
                                     MinHeight="140" />
                            <TextBlock Text="{Binding CharacterTimeline.SummaryText}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Raw Files">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom"
                                    Content="Open Raw"
                                    Command="{Binding OpenSelectedRawFileCommand}" />
                            <ListBox ItemsSource="{Binding Summary.RawFiles}"
                                     SelectedItem="{Binding SelectedRawFile, Mode=TwoWay}"
                                     MinHeight="160" />
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="0" Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Filters">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding EventsExplorer.FreeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text search" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EventsExplorer.Level, UpdateSourceTrigger=PropertyChanged}" ToolTip="Level" />
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding EventsExplorer.Category, UpdateSourceTrigger=PropertyChanged}" ToolTip="Category" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EventsExplorer.EventIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="EventId" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding EventsExplorer.TickKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="TickKey" />

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EventsExplorer.PersonIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="PersonId" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.Subsystem, UpdateSourceTrigger=PropertyChanged}" ToolTip="Subsystem" />
                        <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.RelatedPersonIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="RelatedPersonId" />

                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding EventsExplorer.CorrelationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="CorrelationId" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.InteractionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="InteractionId" />
                        <TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.DecisionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="DecisionId" />

                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.FromText, UpdateSourceTrigger=PropertyChanged}" ToolTip="From timestamp" />
                        <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.ToText, UpdateSourceTrigger=PropertyChanged}" ToolTip="To timestamp" />
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding EventsExplorer.PageSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Page size; prevents loading millions of rows into WPF" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                            <CheckBox Content="Exceptions only" IsChecked="{Binding EventsExplorer.ExceptionsOnly}" Margin="0,4,12,0" />
                            <CheckBox Content="Global only" IsChecked="{Binding EventsExplorer.GlobalOnly}" Margin="0,4,12,0" />
                            <CheckBox Content="Scoped only" IsChecked="{Binding EventsExplorer.ScopedOnly}" Margin="0,4,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Apply Filters" Command="{Binding EventsExplorer.ApplyFiltersCommand}" />
                            <Button Content="Clear" Command="{Binding EventsExplorer.ClearFiltersCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="|&lt;" Command="{Binding EventsExplorer.FirstPageCommand}" />
                            <Button Content="&lt;" Command="{Binding EventsExplorer.PreviousPageCommand}" />
                            <TextBlock Text="{Binding EventsExplorer.PageNumberText}" VerticalAlignment="Center" Margin="8,0" />
                            <Button Content="&gt;" Command="{Binding EventsExplorer.NextPageCommand}" />
                            <Button Content="&gt;|" Command="{Binding EventsExplorer.LastPageCommand}" />
                        </StackPanel>
                        <WrapPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5">
                            <TextBlock Text="Columns:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,0" />
                            <CheckBox Content="Seq" IsChecked="{Binding Columns.EventsSeq}" Margin="0,4,8,0" />
                            <CheckBox Content="Real Time" IsChecked="{Binding Columns.EventsRealTime}" Margin="0,4,8,0" />
                            <CheckBox Content="World" IsChecked="{Binding Columns.EventsWorld}" Margin="0,4,8,0" />
                            <CheckBox Content="Level" IsChecked="{Binding Columns.EventsLevel}" Margin="0,4,8,0" />
                            <CheckBox Content="Person" IsChecked="{Binding Columns.EventsPerson}" Margin="0,4,8,0" />
                            <CheckBox Content="Subsystem" IsChecked="{Binding Columns.EventsSubsystem}" Margin="0,4,8,0" />
                            <CheckBox Content="Event" IsChecked="{Binding Columns.EventsEventId}" Margin="0,4,8,0" />
                            <CheckBox Content="Category" IsChecked="{Binding Columns.EventsCategory}" Margin="0,4,8,0" />
                            <CheckBox Content="Message" IsChecked="{Binding Columns.EventsMessage}" Margin="0,4,8,0" />
                            <CheckBox Content="Sources" IsChecked="{Binding Columns.EventsSources}" Margin="0,4,8,0" />
                        </WrapPanel>
                    </Grid>
                </GroupBox>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding EventsExplorer.Events}"
                          SelectedItem="{Binding EventsExplorer.SelectedEvent, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Seq" Binding="{Binding EventInstanceId}" Width="80" Visibility="{Binding DataContext.Columns.EventsSeq, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Real Time" Binding="{Binding RealTimestamp}" Width="160" Visibility="{Binding DataContext.Columns.EventsRealTime, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="World" Binding="{Binding WorldTimeText}" Width="140" Visibility="{Binding DataContext.Columns.EventsWorld, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60" Visibility="{Binding DataContext.Columns.EventsLevel, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Person" Binding="{Binding PersonId}" Width="190" Visibility="{Binding DataContext.Columns.EventsPerson, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="160" Visibility="{Binding DataContext.Columns.EventsSubsystem, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Event" Binding="{Binding EventId}" Width="70" Visibility="{Binding DataContext.Columns.EventsEventId, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="220" Visibility="{Binding DataContext.Columns.EventsCategory, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" Visibility="{Binding DataContext.Columns.EventsMessage, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Sources" Binding="{Binding SourceCount}" Width="70" Visibility="{Binding DataContext.Columns.EventsSources, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <TabControl Grid.Row="0" Grid.Column="2">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <Button Content="Copy EventInstanceId"
                                    Command="{Binding EventDetails.CopyEventIdCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="EventInstanceId" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.EventInstanceId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="RealTimestamp" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.RealTimestamp, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="WorldTimeText" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.WorldTimeText, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Level / EventId" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Level, Mode=OneWay}" IsReadOnly="True" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.EventId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Category" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Category, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Message" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" AcceptsReturn="True" />
                            <TextBlock Text="Metadata" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.PersonId, Mode=OneWay}" IsReadOnly="True" ToolTip="PersonId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Subsystem, Mode=OneWay}" IsReadOnly="True" ToolTip="Subsystem" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.CorrelationId, Mode=OneWay}" IsReadOnly="True" ToolTip="CorrelationId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.InteractionId, Mode=OneWay}" IsReadOnly="True" ToolTip="InteractionId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.DecisionId, Mode=OneWay}" IsReadOnly="True" ToolTip="DecisionId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.RelatedPersonId, Mode=OneWay}" IsReadOnly="True" ToolTip="RelatedPersonId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.LocationId, Mode=OneWay}" IsReadOnly="True" ToolTip="LocationId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.TickKey, Mode=OneWay}" IsReadOnly="True" ToolTip="TickKey" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="NPC Timeline">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding CharacterTimeline.SummaryText}" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Person:" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding CharacterTimeline.SelectedPersonIdText}" />
                                <TextBlock Grid.Column="2" Text="Events:" FontWeight="SemiBold" Margin="12,2,4,2" />
                                <TextBlock Grid.Column="3" Text="{Binding CharacterTimeline.MatchingEventCount}" />
                                <TextBlock Grid.Column="4" Text="Page size:" FontWeight="SemiBold" Margin="12,2,4,2" />
                                <TextBox Grid.Column="5" Text="{Binding CharacterTimeline.PageSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <Button Grid.Column="6" Content="|&lt;" Command="{Binding CharacterTimeline.FirstPageCommand}" />
                                <Button Grid.Column="7" Content="&lt;" Command="{Binding CharacterTimeline.PreviousPageCommand}" />
                                <TextBlock Grid.Column="8" Text="{Binding CharacterTimeline.PageNumberText}" VerticalAlignment="Center" Margin="8,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="&gt;" Command="{Binding CharacterTimeline.NextPageCommand}" />
                                <Button Content="&gt;|" Command="{Binding CharacterTimeline.LastPageCommand}" />
                            </StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Columns:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,0" />
                                <CheckBox Content="World" IsChecked="{Binding Columns.TimelineWorld}" Margin="0,4,8,0" />
                                <CheckBox Content="Real Time" IsChecked="{Binding Columns.TimelineRealTime}" Margin="0,4,8,0" />
                                <CheckBox Content="Seq" IsChecked="{Binding Columns.TimelineSeq}" Margin="0,4,8,0" />
                                <CheckBox Content="Role" IsChecked="{Binding Columns.TimelineRole}" Margin="0,4,8,0" />
                                <CheckBox Content="Level" IsChecked="{Binding Columns.TimelineLevel}" Margin="0,4,8,0" />
                                <CheckBox Content="Subsystem" IsChecked="{Binding Columns.TimelineSubsystem}" Margin="0,4,8,0" />
                                <CheckBox Content="Category" IsChecked="{Binding Columns.TimelineCategory}" Margin="0,4,8,0" />
                                <CheckBox Content="Tick" IsChecked="{Binding Columns.TimelineTick}" Margin="0,4,8,0" />
                                <CheckBox Content="Related" IsChecked="{Binding Columns.TimelineRelated}" Margin="0,4,8,0" />
                                <CheckBox Content="Message" IsChecked="{Binding Columns.TimelineMessage}" Margin="0,4,8,0" />
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CharacterTimeline.Entries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="World" Binding="{Binding WorldTimeText}" Width="130" Visibility="{Binding DataContext.Columns.TimelineWorld, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Real Time" Binding="{Binding RealTimestamp}" Width="155" Visibility="{Binding DataContext.Columns.TimelineRealTime, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Seq" Binding="{Binding EventInstanceId}" Width="70" Visibility="{Binding DataContext.Columns.TimelineSeq, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Involvement}" Width="70" Visibility="{Binding DataContext.Columns.TimelineRole, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="55" Visibility="{Binding DataContext.Columns.TimelineLevel, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="145" Visibility="{Binding DataContext.Columns.TimelineSubsystem, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180" Visibility="{Binding DataContext.Columns.TimelineCategory, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Tick" Binding="{Binding TickKey}" Width="80" Visibility="{Binding DataContext.Columns.TimelineTick, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Related" Binding="{Binding RelatedPersonId}" Width="170" Visibility="{Binding DataContext.Columns.TimelineRelated, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" Visibility="{Binding DataContext.Columns.TimelineMessage, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Exception">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding EventDetails.SelectedEvent.ExceptionType, Mode=OneWay}" IsReadOnly="True" />
                        <TextBox Grid.Row="1" Text="{Binding EventDetails.SelectedEvent.ExceptionMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" />
                        <TextBox Grid.Row="2" Text="{Binding EventDetails.SelectedEvent.StackTrace, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem Header="Sources">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <TextBlock Text="Columns:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,0" />
                            <CheckBox Content="Kind" IsChecked="{Binding Columns.SourcesKind}" Margin="0,4,8,0" />
                            <CheckBox Content="Person" IsChecked="{Binding Columns.SourcesPerson}" Margin="0,4,8,0" />
                            <CheckBox Content="Subsystem" IsChecked="{Binding Columns.SourcesSubsystem}" Margin="0,4,8,0" />
                            <CheckBox Content="Line" IsChecked="{Binding Columns.SourcesLine}" Margin="0,4,8,0" />
                            <CheckBox Content="File" IsChecked="{Binding Columns.SourcesFile}" Margin="0,4,8,0" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding EventDetails.Sources}"
                                  SelectedItem="{Binding EventDetails.SelectedSource, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding SourceKind}" Width="80" Visibility="{Binding DataContext.Columns.SourcesKind, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Person" Binding="{Binding PersonId}" Width="180" Visibility="{Binding DataContext.Columns.SourcesPerson, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="140" Visibility="{Binding DataContext.Columns.SourcesSubsystem, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="60" Visibility="{Binding DataContext.Columns.SourcesLine, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" Visibility="{Binding DataContext.Columns.SourcesFile, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2"
                                Content="Open Selected Source Raw"
                                Command="{Binding EventDetails.OpenRawSourceCommand}"
                                HorizontalAlignment="Left" />
                    </Grid>
                </TabItem>
                <TabItem Header="Raw">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding RawFile.FilePath, Mode=OneWay}" IsReadOnly="True" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding RawFile.Content, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
            </TabControl>

            <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Diagnostics" Margin="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="Columns:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,0" />
                        <CheckBox Content="Kind" IsChecked="{Binding Columns.DiagnosticsKind}" Margin="0,4,8,0" />
                        <CheckBox Content="Title" IsChecked="{Binding Columns.DiagnosticsTitle}" Margin="0,4,8,0" />
                        <CheckBox Content="Line" IsChecked="{Binding Columns.DiagnosticsLine}" Margin="0,4,8,0" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1"
                              Grid.Column="0"
                              ItemsSource="{Binding Diagnostics.Issues}"
                              SelectedItem="{Binding Diagnostics.SelectedIssue, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="180" Visibility="{Binding DataContext.Columns.DiagnosticsKind, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" Visibility="{Binding DataContext.Columns.DiagnosticsTitle, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="60" Visibility="{Binding DataContext.Columns.DiagnosticsLine, Source={x:Reference Root}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding Diagnostics.SelectedIssue.Description, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
