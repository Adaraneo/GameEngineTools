<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- RenderGrid writes straight into WriteableBitmap.BackBuffer via a raw pointer to avoid an
         extra full-frame managed-array copy (see MainWindow.RenderGrid). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Renders the contour overlay (see MainWindow's ContourSurface) — thousands of individual
         WPF Line objects in OverlayCanvas turned out to be the actual perf bottleneck a real Perf
         Log capture found, worse than the heightmap bitmap itself. SkiaSharp draws them as one
         immediate-mode surface instead of one retained visual-tree object per segment. -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameEngineTools\GameEngineTools.csproj" />
  </ItemGroup>

</Project>
