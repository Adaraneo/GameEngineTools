<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Packaged as a .NET tool (see TerraGen's csproj for the same pattern) so it can be invoked
       as worldgen from anywhere, without remembering the build output path. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>worldgen</ToolCommandName>
    <PackageId>WorldGen</PackageId>
    <Version>1.0.0-preview.4</Version>
    <Authors>50PSoftware</Authors>
    <Description>Generuje lokace, spojení a affordances do world.db na pozicích už vygenerovaných TerraGenem v terrain.db.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the core engine — WorldGen reads TerrainHeightmap/SqliteWorldDatabase from here
         directly, no dependency on TerraGen's tile-generation code (it consumes already-generated
         tiles, never generates them). -->
    <ProjectReference Include="..\GameEngineTools\GameEngineTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorldGenTests" />
  </ItemGroup>

</Project>
