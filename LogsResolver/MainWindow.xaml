<Window x:Class="LogsResolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Logs Resolver"
        Height="900"
        Width="1500"
        MinHeight="700"
        MinWidth="1100">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
            <Button Content="Reload" Command="{Binding ReloadSessionCommand}" />
            <Separator />
            <TextBlock Text="Root:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary.RootPath}" VerticalAlignment="Center" />
        </ToolBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Events:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Summary.EventCount}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="JSONL:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.JsonFileCount}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Text:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.TextFileCount}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Diagnostics:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.DiagnosticCount}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Quick Filters">
                        <StackPanel>
                            <TextBlock Text="Person" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Summary.Persons}"
                                      SelectedItem="{Binding Summary.SelectedPerson, Mode=TwoWay}"
                                      IsEditable="True"
                                      Margin="0,2,0,6" />
                            <TextBlock Text="Subsystem" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Summary.Subsystems}"
                                      SelectedItem="{Binding Summary.SelectedSubsystem, Mode=TwoWay}"
                                      IsEditable="True"
                                      Margin="0,2,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply" Command="{Binding ApplyQuickFiltersCommand}" />
                                <Button Content="Clear" Command="{Binding EventsExplorer.ClearFiltersCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Raw Files">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom"
                                    Content="Open Raw"
                                    Command="{Binding OpenSelectedRawFileCommand}" />
                            <ListBox ItemsSource="{Binding Summary.RawFiles}"
                                     SelectedItem="{Binding SelectedRawFile, Mode=TwoWay}"
                                     MinHeight="160" />
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="0" Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Filters">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding EventsExplorer.FreeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text search" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EventsExplorer.Level, UpdateSourceTrigger=PropertyChanged}" ToolTip="Level" />
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding EventsExplorer.Category, UpdateSourceTrigger=PropertyChanged}" ToolTip="Category" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EventsExplorer.EventIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="EventId" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding EventsExplorer.TickKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="TickKey" />

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EventsExplorer.PersonIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="PersonId" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.Subsystem, UpdateSourceTrigger=PropertyChanged}" ToolTip="Subsystem" />
                        <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.RelatedPersonIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="RelatedPersonId" />

                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding EventsExplorer.CorrelationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="CorrelationId" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.InteractionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="InteractionId" />
                        <TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.DecisionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="DecisionId" />

                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.FromText, UpdateSourceTrigger=PropertyChanged}" ToolTip="From timestamp" />
                        <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EventsExplorer.ToText, UpdateSourceTrigger=PropertyChanged}" ToolTip="To timestamp" />
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding EventsExplorer.MaxResultsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Max grid rows; prevents loading millions of rows into WPF" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                            <CheckBox Content="Exceptions only" IsChecked="{Binding EventsExplorer.ExceptionsOnly}" Margin="0,4,12,0" />
                            <CheckBox Content="Global only" IsChecked="{Binding EventsExplorer.GlobalOnly}" Margin="0,4,12,0" />
                            <CheckBox Content="Scoped only" IsChecked="{Binding EventsExplorer.ScopedOnly}" Margin="0,4,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Apply Filters" Command="{Binding EventsExplorer.ApplyFiltersCommand}" />
                            <Button Content="Clear" Command="{Binding EventsExplorer.ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding EventsExplorer.Events}"
                          SelectedItem="{Binding EventsExplorer.SelectedEvent, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Seq" Binding="{Binding EventInstanceId}" Width="80" />
                        <DataGridTextColumn Header="Real Time" Binding="{Binding RealTimestamp}" Width="160" />
                        <DataGridTextColumn Header="World" Binding="{Binding WorldTimeText}" Width="140" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60" />
                        <DataGridTextColumn Header="Person" Binding="{Binding PersonId}" Width="190" />
                        <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="160" />
                        <DataGridTextColumn Header="Event" Binding="{Binding EventId}" Width="70" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="220" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="Sources" Binding="{Binding SourceCount}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <TabControl Grid.Row="0" Grid.Column="2">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <Button Content="Copy EventInstanceId"
                                    Command="{Binding EventDetails.CopyEventIdCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="EventInstanceId" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.EventInstanceId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="RealTimestamp" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.RealTimestamp, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="WorldTimeText" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.WorldTimeText, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Level / EventId" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Level, Mode=OneWay}" IsReadOnly="True" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.EventId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Category" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Category, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Text="Message" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" AcceptsReturn="True" />
                            <TextBlock Text="Metadata" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.PersonId, Mode=OneWay}" IsReadOnly="True" ToolTip="PersonId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.Subsystem, Mode=OneWay}" IsReadOnly="True" ToolTip="Subsystem" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.CorrelationId, Mode=OneWay}" IsReadOnly="True" ToolTip="CorrelationId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.InteractionId, Mode=OneWay}" IsReadOnly="True" ToolTip="InteractionId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.DecisionId, Mode=OneWay}" IsReadOnly="True" ToolTip="DecisionId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.RelatedPersonId, Mode=OneWay}" IsReadOnly="True" ToolTip="RelatedPersonId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.LocationId, Mode=OneWay}" IsReadOnly="True" ToolTip="LocationId" />
                            <TextBox Text="{Binding EventDetails.SelectedEvent.TickKey, Mode=OneWay}" IsReadOnly="True" ToolTip="TickKey" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Exception">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding EventDetails.SelectedEvent.ExceptionType, Mode=OneWay}" IsReadOnly="True" />
                        <TextBox Grid.Row="1" Text="{Binding EventDetails.SelectedEvent.ExceptionMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" />
                        <TextBox Grid.Row="2" Text="{Binding EventDetails.SelectedEvent.StackTrace, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem Header="Sources">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding EventDetails.Sources}"
                                  SelectedItem="{Binding EventDetails.SelectedSource, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding SourceKind}" Width="80" />
                                <DataGridTextColumn Header="Person" Binding="{Binding PersonId}" Width="180" />
                                <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="140" />
                                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="60" />
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1"
                                Content="Open Selected Source Raw"
                                Command="{Binding EventDetails.OpenRawSourceCommand}"
                                HorizontalAlignment="Left" />
                    </Grid>
                </TabItem>
                <TabItem Header="Raw">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding RawFile.FilePath, Mode=OneWay}" IsReadOnly="True" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding RawFile.Content, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
            </TabControl>

            <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Diagnostics" Margin="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Diagnostics.Issues}"
                              SelectedItem="{Binding Diagnostics.SelectedIssue, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="180" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Column="1"
                             Text="{Binding Diagnostics.SelectedIssue.Description, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
