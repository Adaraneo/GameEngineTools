<Window x:Class="TerrainEditor.LocationDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lokace" Height="360" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Název lokace:" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Margin="0,0,0,10" />

        <TextBlock Text="Typ:" Margin="0,0,0,4" />
        <ComboBox x:Name="TypeComboBox" Margin="0,0,0,10" />

        <TextBlock Text="Terén:" Margin="0,0,0,4" />
        <ComboBox x:Name="TerrainComboBox" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Hlučnost (0-1):" Margin="0,0,0,4" />
                <TextBox x:Name="BaseNoiseTextBox" Text="0.2" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hlučnost/osoba:" Margin="0,0,0,4" />
                <TextBox x:Name="NoisePerPersonTextBox" Text="0.04" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Kapacita:" Margin="0,0,0,4" />
        <TextBox x:Name="CapacityTextBox" Text="20" Margin="0,0,0,10" />

        <CheckBox x:Name="AllowsPrivacyCheckBox" Content="Umožňuje soukromí" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Zrušit" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="Vytvořit" Width="80" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
