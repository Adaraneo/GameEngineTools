<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting via the ASP.NET Core Module v2 (in-process).
  Requires the ".NET 8 Hosting Bundle" installed on the server (provides the runtime + module).
  For WebSocket transport, enable the "WebSocket Protocol" Windows feature; without it SignalR
  transparently falls back to Server-Sent Events / Long Polling.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\WorldObserver.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
