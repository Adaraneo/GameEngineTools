// Object types of the work system. A world object in world.db stores only its typeId (plus owner, condition, place); everything here is read from this file.
// parts: material id and volume in cm3; the weight is computed from the densities in materials.json. The volumes are my estimates, chosen so the computed weights fall in the usual range of the tool.
// toolClasses: what the object can be used as, with a quality (1 is ordinary). durabilityHours: hours of use until worn out; leave out for an object that does not wear.
{
  "types": [
    // Food and drink items. weightGrams: for a type without parts. affordances: what using it gives (Ownership is what holding it is worth). spoilageHours: until fully spoiled.
    // referencePrice: starting price and barter value. All values are design picks of the Tier 1 and Tier 2 food economy (see docs/research/food-economy-research-findings.md).
    { "id": "grain",  "name": "Obilí",         "category": "Food",  "pickable": true, "weightGrams": 200, "affordances": { "Ownership": 0.25 }, "referencePrice": 1.0, "source": "design pick" },
    { "id": "flour",  "name": "Mouka",         "category": "Food",  "pickable": true, "weightGrams": 250, "affordances": { "Ownership": 0.25 }, "referencePrice": 1.5, "source": "design pick" },
    { "id": "milk",   "name": "Mléko",         "category": "Drink", "pickable": true, "weightGrams": 400, "affordances": { "Thirst": 0.5, "Ownership": 0.3 }, "spoilageHours": 60, "referencePrice": 1.0, "source": "design pick; spoilage about 2.5 days" },
    { "id": "bread",  "name": "Čerstvý chléb", "category": "Food",  "pickable": true, "weightGrams": 300, "affordances": { "Hunger": 0.6, "Ownership": 0.4 }, "spoilageHours": 72, "referencePrice": 2.0, "source": "design pick; spoilage about 3 days" },
    { "id": "cheese", "name": "Čerstvý sýr",   "category": "Food",  "pickable": true, "weightGrams": 250, "affordances": { "Hunger": 0.55, "Ownership": 0.4 }, "spoilageHours": 336, "referencePrice": 3.0, "source": "design pick; spoilage about 14 days" },

    // Workstations: where craft tasks are done (the "station" of a task). Immovable. Production is the number of products one action makes (the standard yield, a design pick: a loaf then costs about 1.3 labor hours).
    { "id": "mill",  "name": "Mlýn",     "category": "Ambient", "pickable": false, "weightGrams": 500000, "affordances": { "Production": 2.0 }, "source": "design pick" },
    { "id": "oven",  "name": "Pekárna",  "category": "Ambient", "pickable": false, "weightGrams": 500000, "affordances": { "Production": 2.0 }, "source": "design pick" },
    { "id": "dairy", "name": "Mlékárna", "category": "Ambient", "pickable": false, "weightGrams": 500000, "affordances": { "Production": 1.0 }, "source": "design pick" },

    // Hand tools.
    {
      "id": "spade", "name": "Rýč", "category": "Tool", "pickable": true,
      "parts": [ { "material": "ash_wood", "volumeCm3": 900 }, { "material": "iron", "volumeCm3": 180 } ],
      "toolClasses": { "dig": 1.0 },
      "czech": { "lemma": "rýč", "pattern": "stroj", "gender": "Masculine" },
      "source": "volumes estimated: a hand spade weighs about 1.5-2.5 kg"
    },
    {
      "id": "sickle", "name": "Srp", "category": "Tool", "pickable": true,
      "parts": [ { "material": "ash_wood", "volumeCm3": 120 }, { "material": "iron", "volumeCm3": 40 } ],
      "toolClasses": { "cut_grain": 1.0 },
      "czech": { "lemma": "srp", "pattern": "hrad", "gender": "Masculine" },
      "source": "volumes estimated: a hand sickle weighs about 0.3-0.5 kg"
    },
    {
      "id": "flail", "name": "Cep", "category": "Tool", "pickable": true,
      "parts": [ { "material": "ash_wood", "volumeCm3": 1700 }, { "material": "leather", "volumeCm3": 40 } ],
      "toolClasses": { "thresh": 1.0 },
      "czech": { "lemma": "cep", "pattern": "hrad", "gender": "Masculine" },
      "source": "volumes estimated: a threshing flail weighs about 1-1.5 kg"
    }
  ]
}
